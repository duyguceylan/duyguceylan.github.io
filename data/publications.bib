% Her kalemi icin kullanilabilen alanlar:
%   title       = { ... },              % baslik (kacilmaz)
%   author      = {A and B and ...},    % yazarlar, "and" ile ayir
%   year        = {2025},              % yil
%   month       = {Jul},               % ay (istege bagli)
%   booktitle   = {SIGGRAPH 2025},     % konferans / dergi adi (gosterilir)
%   note        = {Oral Paper},        % vurgu (Oral/Spotlight/Highlight/Course)
%   url         = {https://...},       % kagit PDF'i / arXiv (kacilmaz "Paper")
%   project     = {https://...},       % proje sayfası
%   code        = {https://...},       % kod deposu
%   video       = {https://...},       % video
%   slides      = {https://...},       % slaytlar
%   supplement  = {https://...},       % ek malzeme
%   preview   = {assets/pubs/bir_ad.webp},  % sol taraftaki temsilci resim
